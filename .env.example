# Chiave gratuita da https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Percorso del database SQLite. Con Prisma 7 il percorso e' relativo alla
# radice del progetto (dove sta prisma7.config.ts), non alla cartella prisma/:
# per questo il file finisce dentro prisma/ esplicitamente.
DATABASE_URL="file:./prisma/dev.db"
